# Backend environment variables
# Database
USE_LOCAL_DB=False
USE_TURSO_DB=True
LOCAL_DB_PATH=detomsite_local.db
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
MONGODB_URL=
DATABASE_NAME=detomsite
SEED_DEMO_DATA=False

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=replace-with-long-random-secret
SECRET_KEY=replace-with-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Default Super Admin
DEFAULT_SUPER_ADMIN_EMAIL=12@gmail.com
DEFAULT_SUPER_ADMIN_PASSWORD=8989

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Sentry
SENTRY_DSN=

# Application
APP_NAME=DETOMSITE
APP_VERSION=3.1.0
DEBUG=False
HOST=0.0.0.0
PORT=8001
FRONTEND_URL=https://your-frontend.vercel.app
BACKEND_URL=https://your-backend.vercel.app

# CORS
ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://your-backend.vercel.app,http://localhost:5173
